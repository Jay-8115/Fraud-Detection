# Database Configuration
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Server Ports and Environments
PORT=5000
NODE_ENV=development


# LLM API
GEMINI_API_KEY=your_gemini_api_key_here


GEMINI_API_KEY_2=your_second_gemini_key_here
GROQ_API_KEY=your_groq_key_here
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
AI_ENABLE_FALLBACK=true

GEMINI_API_KEY_3=your_third_gemini_key_here
GEMINI_API_KEY_4=your_fourth_gemini_key_here
GEMINI_KEY_GROUPS=primary-project,primary-project,other-account
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b

# Data Encryption & HMAC Security
# Generate strong 32-byte (64-char) hex strings for these values.
# DO NOT expose these to the browser (do NOT use NEXT_PUBLIC_).
# Generate using: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_char_hex_string
HMAC_KEY=replace_with_another_64_char_hex_string
